NODE_ENV=development
PORT=8000
HOST=127.0.0.1
DATABASE_URL=postgresql://omnischool:change-me@127.0.0.1:5432/omnischool
DATABASE_POOL_MAX=10
SESSION_COOKIE_NAME=omnischool_session
SESSION_TTL_SECONDS=28800
COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUST_PROXY=true
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEMO_MODE=true
SEED_DEMO=true
DEMO_PASSWORD=OmniDemo@2026
SPA_DIST_DIR=../frontend/dist
UPLOAD_DIR=./storage/leave-documents
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=30000
LOG_LEVEL=info
# postgres = buckets shared across API instances; memory = no DB round trip per request.
# Defaults to memory outside production, postgres in production.
#RATE_LIMIT_STORE=postgres
